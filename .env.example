# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# AI models configuration
MODEL_NAME=ProsusAI/finbert
NER_MODEL=en_core_web_sm
OCR_ENGINE=easyocr

# Database URLs
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sentiment_db

# ChromaDB Settings
CHROMADB_PERSIST_DIRECTORY=./chromadb_data
CHROMADB_HOST=
CHROMADB_PORT=

# Feature flags
ENABLE_OCR=true
ENABLE_SUMMARY=true
ENABLE_NER=true
ENABLE_ASPECT_SENTIMENT=true

# Allowed aspects (comma-separated list)
ALLOWED_ASPECTS=Biofuels,Petrochemicals,Hydrogen,SAF,Renewable Energy,Carbon Capture
